/bin/
/dist/
/web/node_modules/
/web/*.tsbuildinfo
# Make stamp inside node_modules used to skip npm ci when the lockfile
# is unchanged. Already covered by /web/node_modules/ above, but listing
# it explicitly so the intent is obvious.
/web/node_modules/.install-stamp
# vite normally writes to internal/webui/dist (per web/vite.config.ts), but
# protect against accidental writes if someone runs vite with a different
# --outDir or another build tool drops output here.
/web/dist/
*.exe
coverage.out
.DS_Store

# go-winres output — regenerated at build time
rsrc_windows_*.syso

# macOS Finder / iCloud Drive conflict-copy pattern: a "foo 2.txt" / "foo 3.html"
# appears next to the real "foo.txt" when sync resolves a conflict. Without this
# rule the dupes get embedded into the Go binary via go:embed internal/webui/dist/*,
# served at URLs like /index 2.html, and picked up by `git add .`.
* [0-9].*
