/bin/
/dist/
/web/node_modules/
/web/*.tsbuildinfo
# Make stamp inside node_modules used to skip npm ci when the lockfile
# is unchanged. Already covered by /web/node_modules/ above, but listing
# it explicitly so the intent is obvious.
/web/node_modules/.install-stamp
# vite normally writes to internal/webui/dist (per web/vite.config.ts), but
# protect against accidental writes if someone runs vite with a different
# --outDir or another build tool drops output here.
/web/dist/
*.exe
coverage.out
.DS_Store

# go-winres output — regenerated at build time
rsrc_windows_*.syso

# macOS Finder / iCloud Drive conflict-copy pattern: a "foo 2.txt" / "foo 3.html"
# appears next to the real "foo.txt" when sync resolves a conflict. Without this
# rule the dupes get embedded into the Go binary via go:embed internal/webui/dist/*,
# served at URLs like /index 2.html, and picked up by `git add .`.
* [0-9].*

# .env files commonly hold secrets (Shodan API keys, etc.). netcheck itself
# doesn't read .env — use ~/.config/netcheck/config.yaml or NETCHECK_* env
# vars instead — but block these from ever being committed by accident.
.env
.env.*
!.env.example

# Structurizr: regenerated on every load while all views use autoLayout.
# Authoring uses automatic layout; do not introduce maintained coordinates.
docs/architecture/workspace.json
docs/architecture/.structurizr/
docs/architecture/generated/
__pycache__/

# Claude Code: .claude/skills/ is tracked (architecture skills); everything
# else under .claude/ is per-machine. worktrees/ holds whole session checkouts
# that break with absolute paths when the repo folder moves.
.claude/worktrees/
.claude/settings.local.json
.claude/launch.json
